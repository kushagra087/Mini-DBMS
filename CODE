import ast 
import json 
import re 
from engine import ( 
ColumnType, create_table, list_table, delete_table, insertColumnIntoTable, 
deleteColumnFromTable, insertDataIntoTable, select_where, select_all, filtering, 
updateDataInTable, deleteDataFromTable, checkIfTableExists 
) 
from src.helper.helper import load_table, save_table 
from src.exceptions.exceptions import EmptyException 
class DatabaseCommandParser: 
def parse_val(self, val_str): 
val_str = val_str.strip() 
try: 
return ast.literal_eval(val_str) 
        except Exception: 
            lv = val_str.lower() 
            if lv == 'true': return True 
            if lv == 'false': return False 
            if lv == 'null': return None 
            return val_str 
 
    def execute_command(self, cmd): 
        try: 
            res = self._parse_and_run(cmd) 
            if res is None: return "Command executed successfully." 
            if hasattr(res, "message"): return res.message 
             
            if isinstance(res, dict): 
                if not res: return "No results." 
                return "\n".join([f"ID: {k} | {json.dumps(v)}" for k, v in res.items()]) 
            if isinstance(res, list): 
                if not res: return "No results." 
                return "\n".join([f"{i+1}. {v}" for i, v in enumerate(res)]) 
                 
            return str(res) 
        except Exception as e: 
            return f"Error: {e}" 
 
    def _parse_and_run(self, cmd): 
        cmd = cmd.strip() 
        if not cmd: return "Command empty." 
         
        m = re.match(r"^CREATE\s+TABLE\s+([\w\-]+)$", cmd, re.I) 
        if m: return create_table(m.group(1)) 
 
        if re.match(r"^SHOW\s+TABLES$", cmd, re.I): 
            return list_table() 
         
        m = re.match(r"^DROP\s+TABLE\s+([\w\-]+)$", cmd, re.I) 
        if m: return delete_table(m.group(1)) 
         
        m = re.match(r"^DROP\s+COLUMN\s+([\w\-]+)\s+([\w\-]+)$", cmd, re.I) 
        if m: return deleteColumnFromTable(m.group(1), m.group(2)) 
 
        m = re.match(r"^ADD\s+COLUMN\s+([\w\-]+)\s+([\w\-]+)\s+([\w\-]+)$", cmd, re.I) 
        if m: 
            table, col, ctype = m.groups() 
            checkIfTableExists(table) 
            data = load_table(table) 
             
            if len(data) == 0: 
                data["0"] = {} 
                save_table(table, data) 
             
            enum_type = ColumnType.String 
            ctype_u = ctype.upper() 
            if ctype_u in ["INTEGER", "INT"]: enum_type = ColumnType.Integer 
            elif ctype_u in ["DECIMAL", "FLOAT"]: enum_type = ColumnType.Decimal 
             
            return insertColumnIntoTable(table, col, enum_type) 
             
        m = re.match(r"^INSERT\s+INTO\s+([\w\-]+)\s+VALUES\s+(.+)$", cmd, re.I) 
        if m: 
            table, val_str = m.groups() 
            row_data = ast.literal_eval(val_str.strip()) 
            return insertDataIntoTable(table, row_data) 
 
        m = re.match(r"^SELECT\s+\*\s+FROM\s+([\w\-]+)\s+WHERE\s+([\w\
]+)\s*(>=|<=|=|>|<)\s*(.+)$", cmd, re.I) 
        if m: 
            table, field, op, val = m.groups() 
            res = select_where(table, field, op, self.parse_val(val)) 
            if "0" in res: del res["0"] 
            if not res: raise EmptyException("No results were found") 
            return res 
 
        m = re.match(r"^SELECT\s+([\w\-]+)\s+FROM\s+([\w\-]+)$", cmd, re.I) 
        if m: 
            col, table = m.groups() 
            if col == "*": 
                res = select_all(table) 
                if "0" in res: del res["0"] 
                if not res: raise EmptyException("No results were found") 
                return res 
            else: 
                checkIfTableExists(table) 
                data = load_table(table) 
                filtered = [row[col] for rid, row in data.items() if rid != "0" and col in row] 
                if not filtered: raise EmptyException("No results were found") 
                return filtered 
 
        m = re.match(r"^UPDATE\s+([\w\-]+)\s+SET\s+([\w\
]+)\s*=\s*(.+?)\s+WHERE\s+id\s*=\s*(\d+)$", cmd, re.I) 
        if m: 
            table, col, val_str, rid = m.groups() 
            return updateDataInTable(table, int(rid), col, self.parse_val(val_str)) 
 
        m = re.match(r"^DELETE\s+FROM\s+([\w\-]+)\s+COLUMN\s+([\w\
]+)\s+WHERE\s+id\s*=\s*(\d+)$", cmd, re.I) 
        if m: 
            table, col, rid = m.groups() 
            return deleteDataFromTable(table, int(rid), col) 
 
        raise ValueError("Syntax Error: Unknown or malformed command.") 
 
 
 
 
 
 
 
 
 
 
