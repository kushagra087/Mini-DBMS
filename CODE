import tkinter as tk 
from tkinter import ttk, messagebox 
import json 
 
from db_parser import DatabaseCommandParser 
from src.helper.helper import load_table, save_table 
 
class TextDBApp: 
    def __init__(self, root): 
        self.root = root 
        self.root.title("Mini Text Database - Desktop App") 
        self.root.geometry("950x700") 
        self.current_table = tk.StringVar() 
        self.parser = DatabaseCommandParser() 
        self.setup_ui() 
 
    def setup_ui(self): 
        self.sidebar = tk.Frame(self.root, width=200, bg="#e0e0e0", relief="sunken", bd=2) 
        self.sidebar.pack(side="left", fill="y") 
 
        tk.Label(self.sidebar, text="Active Table:", bg="#e0e0e0", font=("Arial", 10, 
"bold")).pack(pady=(20, 5)) 
        self.table_selector = ttk.Combobox(self.sidebar, textvariable=self.current_table, 
state="readonly") 
        self.table_selector.pack(padx=10, fill="x") 
        self.table_selector.bind("<<ComboboxSelected>>", lambda e: self.render_list_view()) 
 
        tk.Button(self.sidebar, text="Create Table", 
command=self.open_create_table_modal).pack(pady=(20, 5), padx=10, fill="x") 
        tk.Button(self.sidebar, text="Add Column", 
command=self.open_add_column_modal).pack(pady=5, padx=10, fill="x") 
        tk.Button(self.sidebar, text="Create Record", 
command=self.open_create_modal).pack(pady=5, padx=10, fill="x") 
        tk.Button(self.sidebar, text="List Records", command=self.render_list_view).pack(pady=5, 
padx=10, fill="x") 
        tk.Button(self.sidebar, text="Delete Table", command=self.delete_current_table, 
fg="red").pack(pady=(25, 5), padx=10, fill="x") 
 
        self.main_area = tk.Frame(self.root, bg="white") 
        self.main_area.pack(side="right", fill="both", expand=True) 
 
        self.query_frame = tk.Frame(self.main_area, bg="#f8f8f8", bd=1, relief="solid") 
        self.query_frame.pack(fill="x", padx=10, pady=10) 
         
        tk.Label(self.query_frame, text="Search:", bg="#f8f8f8").pack(side="left", padx=5, pady=5) 
        self.search_field = ttk.Combobox(self.query_frame, width=15, state="readonly") 
        self.search_field.pack(side="left", padx=5, pady=5) 
        self.search_op = ttk.Combobox(self.query_frame, width=5, values=["=", ">", "<", ">=", "<="], 
state="readonly") 
        self.search_op.pack(side="left", padx=5, pady=5) 
        self.search_op.set("=") 
        self.search_val = tk.Entry(self.query_frame, width=15) 
        self.search_val.pack(side="left", padx=5, pady=5) 
        tk.Button(self.query_frame, text="Search", command=self.perform_search).pack(side="left", 
padx=5, pady=5) 
        tk.Button(self.query_frame, text="Reset", command=self.render_list_view).pack(side="left", 
padx=5, pady=5) 
 
        self.cli_frame = tk.Frame(self.main_area, bg="#1e1e1e", bd=2, relief="sunken") 
        self.cli_frame.pack(side="bottom", fill="x", padx=10, pady=10) 
        tk.Label(self.cli_frame, text="Terminal Output:", bg="#1e1e1e", fg="#a0a0a0", 
font=("Consolas", 8)).pack(anchor="w", padx=5, pady=(2, 0)) 
        self.cli_output = tk.Text(self.cli_frame, height=5, bg="#1e1e1e", fg="#4af626", 
font=("Consolas", 10), state="disabled", bd=0) 
        self.cli_output.pack(fill="x", padx=5, pady=2) 
         
        input_frame = tk.Frame(self.cli_frame, bg="#1e1e1e") 
        input_frame.pack(fill="x", padx=5, pady=(0, 5)) 
        tk.Label(input_frame, text="TextDB> ", bg="#1e1e1e", fg="#ffffff", font=("Consolas", 10, 
"bold")).pack(side="left") 
        self.cli_input = tk.Entry(input_frame, bg="#1e1e1e", fg="#ffffff", font=("Consolas", 10), 
insertbackground="white", bd=0) 
        self.cli_input.pack(side="left", fill="x", expand=True) 
        self.cli_input.bind("<Return>", self.handle_cli_command) 
 
        btn_frame = tk.Frame(self.main_area, bg="white") 
        btn_frame.pack(side="bottom", fill="x", padx=10, pady=(0, 5)) 
        tk.Button(btn_frame, text="✎ Edit Selected Record", 
command=self.open_edit_modal).pack(side="left", padx=5) 
        tk.Button(btn_frame, text="🗑 Delete Selected Record", 
command=self.delete_selected_record, fg="red").pack(side="right", padx=5) 
 
        self.tree_frame = tk.Frame(self.main_area) 
        self.tree_frame.pack(fill="both", expand=True, padx=10, pady=5) 
        self.tree = ttk.Treeview(self.tree_frame, show="headings") 
        self.tree.pack(side="left", fill="both", expand=True) 
        scrollbar = ttk.Scrollbar(self.tree_frame, orient="vertical", command=self.tree.yview) 
        scrollbar.pack(side="right", fill="y") 
        self.tree.configure(yscrollcommand=scrollbar.set) 
        self.refresh_table_list() 
 
    def handle_cli_command(self, event): 
        cmd_str = self.cli_input.get().strip() 
        if not cmd_str: return 
        self.cli_input.delete(0, tk.END) 
        self.log_to_cli(f"TextDB> {cmd_str}") 
         
        output = self.parser.execute_command(cmd_str) 
        self.log_to_cli(str(output)) 
        self.refresh_table_list() 
        self.render_list_view() 
 
    def log_to_cli(self, message): 
        self.cli_output.config(state="normal") 
        self.cli_output.insert(tk.END, message + "\n") 
        self.cli_output.see(tk.END) 
        self.cli_output.config(state="disabled") 
 
    def refresh_table_list(self): 
        try: 
            tables_output = self.parser.execute_command("SHOW TABLES") 
            if "Error" not in tables_output and "No results" not in tables_output: 
                tables = [t.split(". ")[1] for t in tables_output.split("\n") if ". " in t] 
                self.table_selector["values"] = tables 
                if tables and not self.current_table.get(): 
                    self.table_selector.current(0) 
                    self.render_list_view() 
            else: 
                self.table_selector["values"] = [] 
                self.current_table.set("") 
                self.render_list_view() 
        except Exception: 
            pass 
 
    def render_list_view(self, event=None, search_results=None): 
        for item in self.tree.get_children(): 
            self.tree.delete(item) 
 
        table = self.current_table.get() 
        if not table: 
            self.tree["columns"] = () 
            return 
        try: 
            data = search_results if search_results is not None else load_table(table) 
            if "0" in data: 
                columns = list(data["0"].keys()) 
                del data["0"] 
            else: 
                columns = [] 
                for details in data.values(): 
                    for col in details.keys(): 
                        if col not in columns: columns.append(col) 
             
            all_cols = ["ID"] + columns 
            self.tree["columns"] = all_cols 
            self.search_field["values"] = columns 
 
            for col in all_cols: 
                self.tree.heading(col, text=col) 
                self.tree.column(col, width=100, anchor="w") 
 
            for row_id, details in data.items(): 
                row_values = [row_id] + [details.get(col, "") for col in columns] 
                self.tree.insert("", "end", iid=row_id, values=row_values) 
        except Exception: 
            self.tree["columns"] = () 
 
    def perform_search(self): 
        table = self.current_table.get() 
        field = self.search_field.get() 
        op = self.search_op.get() 
        val_str = self.search_val.get() 
        if not table or not field or not val_str: return 
         
        cmd = f"SELECT * FROM {table} WHERE {field} {op} {val_str}" 
        self.log_to_cli(f"TextDB> {cmd}") 
        try: 
            res = self.parser._parse_and_run(cmd) 
            self.render_list_view(search_results=res) 
            self.log_to_cli("Query executed successfully.") 
        except Exception as e: 
            self.render_list_view(search_results={}) 
            self.log_to_cli(f"Error: {e}") 
 
    def open_add_column_modal(self): 
        table = self.current_table.get() 
        if not table: return 
 
        modal = tk.Toplevel(self.root) 
        modal.title("Add Column") 
        modal.geometry("250x200") 
        modal.grab_set() 
 
        tk.Label(modal, text="Column Name:").pack(pady=(10, 0)) 
        entry_name = tk.Entry(modal) 
        entry_name.pack(pady=5) 
         
        tk.Label(modal, text="Data Type:").pack(pady=(10, 0)) 
        type_combo = ttk.Combobox(modal, values=["STRING", "INTEGER", "DECIMAL"], 
state="readonly") 
        type_combo.set("STRING") 
        type_combo.pack(pady=5) 
 
        def save_column(): 
            col_name = entry_name.get().strip().replace(" ", "_") 
            if not col_name: return 
            cmd = f"ADD COLUMN {table} {col_name} {type_combo.get().strip()}" 
            output = self.parser.execute_command(cmd) 
            self.log_to_cli(f"TextDB> {cmd}") 
            self.log_to_cli(str(output)) 
            self.render_list_view() 
            modal.destroy() 
 
        tk.Button(modal, text="Add", command=save_column).pack(pady=10) 
 
    def open_create_modal(self): 
        table = self.current_table.get() 
        if not table: return 
 
        try: 
            data = load_table(table) 
        except Exception: 
            data = {} 
 
        columns = [] 
        if "0" in data: 
            columns = list(data["0"].keys()) 
        else: 
            for details in data.values(): 
                for col in details.keys(): 
                    if col not in columns: columns.append(col) 
         
        if not columns: 
            messagebox.showwarning("No Columns", "This table has no columns yet.\nPlease click 
'Add Column' to define the format first!") 
            return 
 
        modal = tk.Toplevel(self.root) 
        modal.title("Create Record") 
        modal.geometry("350x400") 
        modal.grab_set() 
 
        entries = {} 
        tk.Label(modal, text="Enter Record Details:").pack(pady=(10, 0)) 
        for col in columns: 
            tk.Label(modal, text=f"{col}:").pack(pady=(5, 0)) 
            ent = tk.Entry(modal, width=30) 
            ent.pack() 
            entries[col] = ent 
 
        def save(): 
            row_dict = {col: self.parser.parse_val(ent.get().strip()) for col, ent in entries.items()} 
            cmd = f"INSERT INTO {table} VALUES {json.dumps(row_dict)}" 
            output = self.parser.execute_command(cmd) 
            self.log_to_cli(f"TextDB> {cmd}") 
            self.log_to_cli(str(output)) 
            self.render_list_view() 
            modal.destroy() 
 
        tk.Button(modal, text="Save Record", command=save).pack(pady=15) 
 
    def open_edit_modal(self): 
        selected_item = self.tree.selection() 
        if not selected_item: return 
        table = self.current_table.get() 
        record_id = selected_item[0] 
        row_values = self.tree.item(record_id)['values'] 
         
        try: 
            data = load_table(table) 
            columns = list(data[record_id].keys()) 
        except Exception: return 
 
        modal = tk.Toplevel(self.root) 
        modal.title(f"Edit Record ID: {record_id}") 
        modal.geometry("350x400") 
        modal.grab_set() 
 
        entries = {} 
        for i, col in enumerate(columns): 
            tk.Label(modal, text=f"{col}:").pack(pady=(5, 0)) 
            ent = tk.Entry(modal, width=30) 
            ent.insert(0, str(row_values[i+1])) 
            ent.pack() 
            entries[col] = ent 
 
        def save_edits(): 
            try: 
                for col, ent in entries.items(): 
                    val = self.parser.parse_val(ent.get().strip()) 
                    self.parser.execute_command(f"UPDATE {table} SET {col} = {repr(val)} WHERE id = 
{record_id}") 
                self.render_list_view() 
                modal.destroy() 
            except Exception as e: messagebox.showerror("Error", str(e)) 
 
        tk.Button(modal, text="Save Edits", command=save_edits).pack(pady=15) 
 
    def delete_selected_record(self): 
        selected_item = self.tree.selection() 
        if not selected_item: return 
        record_id = selected_item[0] 
        if messagebox.askyesno("Confirm", f"Delete row ID {record_id}?"): 
            try: 
                data = load_table(self.current_table.get()) 
                if record_id in data: 
                    del data[record_id] 
                    save_table(self.current_table.get(), data) 
                self.render_list_view() 
            except Exception as e: messagebox.showerror("Error", str(e)) 
 
    def open_create_table_modal(self): 
        modal = tk.Toplevel(self.root) 
        modal.title("Create Table") 
        modal.geometry("250x150") 
        modal.grab_set() 
 
        tk.Label(modal, text="Table Name:").pack(pady=(20, 5)) 
        entry_table = tk.Entry(modal) 
        entry_table.pack(pady=5) 
 
        def save_table_action(): 
            t_name = entry_table.get().strip().replace(" ", "_") 
            if not t_name: return 
            cmd = f"CREATE TABLE {t_name}" 
            output = self.parser.execute_command(cmd) 
            self.log_to_cli(f"TextDB> {cmd}") 
            self.log_to_cli(str(output)) 
            self.refresh_table_list() 
            modal.destroy() 
 
        tk.Button(modal, text="Create", command=save_table_action).pack(pady=10) 
 
    def delete_current_table(self): 
        table_name = self.current_table.get() 
        if not table_name: return 
        if messagebox.askyesno("Delete Table", f"Delete '{table_name}' entirely?"): 
            cmd = f"DROP TABLE {table_name}" 
            output = self.parser.execute_command(cmd) 
            self.log_to_cli(f"TextDB> {cmd}") 
            self.log_to_cli(str(output)) 
            self.current_table.set("") 
            self.refresh_table_list() 
            self.render_list_view() 
